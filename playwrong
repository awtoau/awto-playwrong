#!/usr/bin/env python3
"""playwrong — run the CLI straight from a checkout, with no install and no PATH setup:

    ./playwrong https://awto.au

Symlink it onto your PATH (scripts/install.py --link does this) and it works from anywhere; the
symlink is resolved below so the repo is still found. `pip install .` also provides the same command
via [project.scripts].
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))   # realpath: follow the symlink home
from engine.cli import main                                       # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
